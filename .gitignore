
# Cargo's output, wherever a build or a bench puts it.
target/
__pycache__/

# direnv keeps its cache here.
/.direnv/

# Machine-local account names and path overrides; never credentials in source.
/.envrc.local

# cargo-mutants scratch output.
mutants.out/
mutants.out.old/

# Mod build output. `mod/deploy.sh` rebuilds it and copies the dll into the
# game directory; nothing here is an input to anything.
mod/*/bin/
mod/*/obj/
