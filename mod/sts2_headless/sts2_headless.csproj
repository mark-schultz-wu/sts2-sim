<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>12.0</LangVersion>
    <!-- The loader looks for <manifest id>.dll, so this must equal the id. -->
    <AssemblyName>sts2_headless</AssemblyName>
    <RootNamespace>Sts2Headless</RootNamespace>
    <EnableDefaultCompileItems>true</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <!-- Private=false: the game supplies these at runtime, we must not ship copies. -->
    <Reference Include="sts2">
      <HintPath>$(Sts2PinDir)/sts2.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(Sts2PinDir)/0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Supplied at runtime by the sts2_determinism mod, which the manifest
         declares a dependency on; the loader guarantees it is loaded first. -->
    <Reference Include="sts2_determinism">
      <HintPath>../sts2_determinism/bin/Release/net9.0/sts2_determinism.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="GodotSharp">
      <HintPath>$(Sts2GameDir)/GodotSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!--
    The mod's identity, compiled in. `identity.sh` hashes this directory's
    sources; the Rust client hashes them the same way at its own build time and
    refuses a greeting that disagrees, so a mod that was not redeployed is
    caught at the handshake rather than mid-run.

    Generated into obj/ so it sits outside the *.cs glob the script hashes:
    a generated file that fed its own hash would never settle.
  -->
  <Target Name="StampIdentity" BeforeTargets="BeforeCompile">
    <Exec Command="sh &quot;$(MSBuildProjectDirectory)/identity.sh&quot;"
          ConsoleToMSBuild="true" StandardOutputImportance="low">
      <Output TaskParameter="ConsoleOutput" PropertyName="ModIdentity" />
    </Exec>
    <PropertyGroup>
      <ModIdentityFile>$(IntermediateOutputPath)ModIdentity.cs</ModIdentityFile>
    </PropertyGroup>
    <WriteLinesToFile File="$(ModIdentityFile)" Overwrite="true" WriteOnlyWhenDifferent="true"
                      Lines="// Generated by the StampIdentity target. Do not edit.;namespace Sts2Headless%3B;internal static class ModIdentity;{;    internal const string Identity = &quot;$(ModIdentity)&quot;%3B;}" />
    <ItemGroup>
      <Compile Include="$(ModIdentityFile)" />
    </ItemGroup>
  </Target>

</Project>
