<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>12.0</LangVersion>
    <!-- The loader looks for <manifest id>.dll, so this must equal the id. -->
    <AssemblyName>sts2_determinism</AssemblyName>
    <RootNamespace>Sts2Determinism</RootNamespace>
    <EnableDefaultCompileItems>true</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <!-- Private=false: the game supplies these at runtime, we must not ship copies. -->
    <Reference Include="sts2">
      <HintPath>$(Sts2PinDir)/sts2.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(Sts2PinDir)/0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!--
    The build this mod refuses to run against anything but, from the lock that
    `mod/build.sh` read. Generated rather than written in the source: the same
    lesson `Protocol.cs` records, that a literal transcribed beside the thing it
    describes is a constant validating itself.

    Generated into obj/ so it is not a source file anyone can edit by hand.
  -->
  <Target Name="StampPin" BeforeTargets="BeforeCompile">
    <Error Condition="'$(Sts2AssemblyHash)' == ''"
           Text="Sts2AssemblyHash is not set. Build through mod/build.sh, which reads it from the lock." />
    <PropertyGroup>
      <PinFile>$(IntermediateOutputPath)Pin.cs</PinFile>
    </PropertyGroup>
    <WriteLinesToFile File="$(PinFile)" Overwrite="true" WriteOnlyWhenDifferent="true"
                      Lines="// Generated by the StampPin target. Do not edit.;namespace Sts2Determinism%3B;internal static class Pin;{;    internal const int AssemblyHash = $(Sts2AssemblyHash)%3B;    internal const string Version = &quot;$(Sts2GameVersion)&quot;%3B;}" />
    <ItemGroup>
      <Compile Include="$(PinFile)" />
    </ItemGroup>
  </Target>

</Project>
