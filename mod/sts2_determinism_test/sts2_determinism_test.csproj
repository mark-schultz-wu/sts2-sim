<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>12.0</LangVersion>
    <!-- The loader looks for <manifest id>.dll, so this must equal the id. -->
    <AssemblyName>sts2_determinism_test</AssemblyName>
    <RootNamespace>Sts2DeterminismTest</RootNamespace>
    <EnableDefaultCompileItems>true</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <!-- Private=false throughout: the game and the other mods supply these at
         runtime, and shipping copies would mean running a stale one.

         sts2_determinism is a manifest dependency but not a compile-time one:
         this measures the game's behaviour, not that mod's API. -->
    <Reference Include="sts2">
      <HintPath>$(Sts2PinDir)/sts2.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="sts2_headless">
      <HintPath>../sts2_headless/bin/Release/net9.0/sts2_headless.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
