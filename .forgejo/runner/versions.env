# What the runner image bakes, and what CI asserts it found.
#
# One place, because two places drift. A workflow that installs a toolchain
# names the version, and an image that bakes one names it again. The image is
# built from these values, and the workflow checks against them. So a stale
# image fails the run rather than quietly testing the wrong compiler.
RUST_VERSION=1.96.0
DOTNET_CHANNEL=9.0
