#!/usr/bin/env bash
# Runs the half of CI that needs nothing but this repository, before a push can
# put a red run in front of a reviewer.
#
# `check-repo` and not `check`: the mod build needs the game's own assemblies,
# which are not in the repository and are not on every machine. CI still runs
# both, so this narrows what a push can catch. It does not widen what CI checks.
#
# The commit messages are part of it. Vale reads the messages this branch adds
# to its base, and a message is the one thing a push cannot fix afterwards
# without rewriting history.
#
# To skip it for one push, `git push --no-verify`. A push that skips this is a
# push that finds out from CI instead.
set -euo pipefail

# A delete has nothing to check, and neither does a push whose refs are all
# deletes. Git names each on standard input as `<local ref> <local sha> ...`,
# and a delete carries the all-zero local sha.
pushing=0
while read -r _ local_sha _ _; do
    case "$local_sha" in
        "" | *[!0]*) pushing=1 ;;
    esac
done
test "$pushing" -eq 1 || exit 0

if ! command -v just >/dev/null; then
    echo "pre-push: just is not installed. See the justfile for what CI runs." >&2
    exit 1
fi

exec just check-repo
