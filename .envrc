# Loaded by direnv on entering this directory. Run `direnv allow` once.
#
# Without this, anything invoking cargo directly -- `cargo run --example ...`,
# `cargo test -- --include-ignored` -- needs STS2_GAME_DIR passed by hand. The
# justfile has its own default, so `just` recipes work either way.
#
# Assigned rather than forced, so an explicit value in the environment still
# wins: `STS2_GAME_DIR=/some/other/install cargo test` does what it says.
export STS2_GAME_DIR="${STS2_GAME_DIR:-/etc/wolf/profile-data/user/WolfSteam/.steam/steam/steamapps/common/Slay the Spire 2}"
