# Loaded by direnv on entering this directory. Run `direnv allow` once.
#
# This is the only place the game's location is written down: the justfile reads
# STS2_GAME_DIR with no default, and anything going through cargo -- `cargo run
# --example ...`, `cargo test -- --include-ignored` -- needs it too. So without
# direnv allowed, both fail rather than silently using a stale path.
#
# It points at the vendored copy, not at Steam's. Steam's install is
# world-writable and updates on its own schedule, so pointing tests at it means
# a run can change because the game changed underneath them -- which does not
# look like a stale pin, it looks like a bug in the simulator. `mod/game.sh
# fetch-game` puts the pinned build here; the selected lock under mod/games/
# says which build.
#
# Assigned rather than forced, so an explicit value in the environment still
# wins: `STS2_GAME_DIR=/some/other/install cargo test` does what it says.
export STS2_GAME_VERSION="${STS2_GAME_VERSION:-v0.107.1}"
export STS2_GAME_DIR="${STS2_GAME_DIR:-${XDG_DATA_HOME:-$HOME/.local/share}/sts2/games/$STS2_GAME_VERSION}"

# Account names and machine-specific overrides belong in this ignored file.
source_env_if_exists .envrc.local
